			$begin 'definewinding3D'
				ScriptLang='vbscript'
				ScriptText=$begin_cdata$ Dim oAnsoftApp
Dim oDesktop
Dim oProject
Dim oDesign
Dim oEditor
Dim oModule
Set oAnsoftApp = CreateObject("Ansoft.ElectronicsDesktop")
Set oDesktop = oAnsoftApp.GetAppDesktop()
oDesktop.RestoreWindow


Set oProject = oDesktop.SetActiveProject("axial_flux")

Set oDesign = oProject.SetActiveDesign("magnetic loading1")

Set oModule = oDesign.GetModule("BoundarySetup")


phaseA= array(1,10,-2,-11,-9,-18)
phaseB= array(7,16,-8,-17,-15,-6)
phaseC= array(13,4,-14,-5,-3,-12)

for i = 0 to ubound(phaseA)

cname = "coilinput_"+cstr(abs(phaseA(i)))

if (phaseA(i) > 0) then  
oModule.AssignCoilTerminal Array("NAME:" +cname, "Objects:=", Array( _
  cname), "Conductor number:=", "$Ntc", "Point out of terminal:=", true)
else
oModule.AssignCoilTerminal Array("NAME:" +cname, "Objects:=", Array( _
  cname), "Conductor number:=", "$Ntc", "Point out of terminal:=", false) 
end if 
oModule.AddWindingTerminals "phaseA", Array(cname)


cname = " coilinput_"+cstr(abs(phaseB(i)))

if (phaseB(i)  > 0) then  
oModule.AssignCoilTerminal Array("NAME:" +cname, "Objects:=", Array( _
  cname), "Conductor number:=", "$Ntc", "Point out of terminal:=", true)
else
oModule.AssignCoilTerminal Array("NAME:" +cname, "Objects:=", Array( _
  cname), "Conductor number:=", "$Ntc", "Point out of terminal:=", false) 
end if 
oModule.AddWindingTerminals "phaseB", Array(cname)


cname = " coilinput_"+cstr(abs(phaseC(i)))

if (phaseC(i)  > 0) then  
oModule.AssignCoilTerminal Array("NAME:" +cname, "Objects:=", Array( _
  cname), "Conductor number:=", "$Ntc", "Point out of terminal:=", true)
else
oModule.AssignCoilTerminal Array("NAME:" +cname, "Objects:=", Array( _
  cname), "Conductor number:=", "$Ntc", "Point out of terminal:=", false) 
end if 
oModule.AddWindingTerminals "phaseC", Array(cname)

next $end_cdata$
				ModTime=1781593368
				Library=''
				LibLocation='Project'
				ModSinceLib=true
			$end 'definewinding3D'
			$begin 'winding2d'
				ScriptLang='vbscript'
				ScriptText=$begin_cdata$ Dim oAnsoftApp
Dim oDesktop
Dim oProject
Dim oDesign
Dim oEditor
Dim oModule
Set oAnsoftApp = CreateObject("Ansoft.ElectronicsDesktop")
Set oDesktop = oAnsoftApp.GetAppDesktop()
oDesktop.RestoreWindow
Set oProject = oDesktop.GetActiveProject()

Set oDesign = oProject.SetActiveDesign("steady_state_2d")

Set oModule = oDesign.GetModule("BoundarySetup")

phaseA= array(1,10,-2,-11,-9,-18)
phaseB= array(7,16,-8,-17,-15,-6)
phaseC= array(13,4,-14,-5,-3,-12)

for i = 0 to ubound(phaseA)

cin_cname = "scain"+cstr(abs(phaseA(i)))
cout_cname = "scaout"+cstr(abs(phaseA(i)))

if (phaseA(i) > 0) then  
oModule.AssignCoil Array("NAME:"+cin_cname, "Objects:=", Array(cin_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Positive")
oModule.AssignCoil Array("NAME:"+cout_cname, "Objects:=", Array(cout_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Negative")
else 
oModule.AssignCoil Array("NAME:"+cin_cname, "Objects:=", Array(cin_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Negative")
oModule.AssignCoil Array("NAME:"+cout_cname, "Objects:=", Array(cout_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Positive")
end if 
oModule.AddWindingCoils "phaseA", Array(cin_cname)
oModule.AddWindingCoils "phaseA", Array(cout_cname)

cin_cname = "scain"+cstr(abs(phaseB(i)))
cout_cname = "scaout"+cstr(abs(phaseB(i)))

if (phaseB(i) > 0) then  
oModule.AssignCoil Array("NAME:"+cin_cname, "Objects:=", Array(cin_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Positive")
oModule.AssignCoil Array("NAME:"+cout_cname, "Objects:=", Array(cout_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Negative")
else 
oModule.AssignCoil Array("NAME:"+cin_cname, "Objects:=", Array(cin_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Negative")
oModule.AssignCoil Array("NAME:"+cout_cname, "Objects:=", Array(cout_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Positive")
end if 
oModule.AddWindingCoils "phaseB", Array(cin_cname)
oModule.AddWindingCoils "phaseB", Array(cout_cname)

cin_cname = "scain"+cstr(abs(phaseC(i)))
cout_cname = "scaout"+cstr(abs(phaseC(i)))

if (phaseC(i) > 0) then  
oModule.AssignCoil Array("NAME:"+cin_cname, "Objects:=", Array(cin_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Positive")
oModule.AssignCoil Array("NAME:"+cout_cname, "Objects:=", Array(cout_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Negative")
else 
oModule.AssignCoil Array("NAME:"+cin_cname, "Objects:=", Array(cin_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Negative")
oModule.AssignCoil Array("NAME:"+cout_cname, "Objects:=", Array(cout_cname), "Conductor number:=",  _
  "$Ntc", "PolarityType:=", "Positive")
end if 
oModule.AddWindingCoils "phaseC", Array(cin_cname)
oModule.AddWindingCoils "phaseC", Array(cout_cname)

next $end_cdata$
