 PORT ROTATIONAL: T2; \
 PORT string in: Maxwell_Host; \
 PORT string in: Maxwell_HostPort; \
 PORT real out: TORQUE = MAXWELL.VEC[0]; \
 PORT real out: PHI = MAXWELL.VEC[1]; \
 PORT real out: OMEGA = MAXWELL.VEC[2]; \
 PORT real out: FEA_STEPS = MAXWELL.VEC[3]; \
 UMODEL FEA_LINK MAXWELL N0:=T1,N1:=T2 (host:= Maxwell_Host, port:= Maxwell_HostPort, min_fea_step:=hmin, VECSIZE:=4) SRC: DB(Lib:="Simplorer Elements\\Basic Elements\\Basic Elements"); \
 }'
