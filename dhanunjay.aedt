 { \
 PORT ELECTRICAL: T1; \
 PORT ELECTRICAL: T2; \
 PORT ELECTRICAL: T3; \
 PORT ROTATIONAL: T4; \
 PORT ELECTRICAL: T5; \
 PORT ELECTRICAL: T6; \
