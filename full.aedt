					ModelText='SMLDEF MxTranTranData3 \
 { \
 PORT ELECTRICAL: T1; \
 PORT ELECTRICAL: T2; \
 PORT ELECTRICAL: T3; \
 PORT ROTATIONAL: T4; \
 PORT ELECTRICAL: T5; \
 PORT ELECTRICAL: T6; \
 PORT ELECTRICAL: T7; \
 PORT ROTATIONAL: T8; \
 PORT string in: Maxwell_Host; \
 PORT string in: Maxwell_HostPort; \
 PORT real out: WIRELOSS = MAXWELL.VEC[0]; \
 PORT real out: CORELOSS = MAXWELL.VEC[1]; \
 PORT real out CURRENT: IT1 = MAXWELL.VEC[2]; \
 PORT real out VOLTAGE: VT1 = MAXWELL.VEC[3]; \
 PORT real out VOLTAGE: EIT1 = MAXWELL.VEC[4]; \
 PORT real out MAGNETIC_FLUX: FLUXT1 = MAXWELL.VEC[5]; \
 PORT real out CURRENT: IT2 = MAXWELL.VEC[6]; \
 PORT real out VOLTAGE: VT2 = MAXWELL.VEC[7]; \
 PORT real out VOLTAGE: EIT2 = MAXWELL.VEC[8]; \
 PORT real out MAGNETIC_FLUX: FLUXT2 = MAXWELL.VEC[9]; \
 PORT real out CURRENT: IT3 = MAXWELL.VEC[10]; \
 PORT real out VOLTAGE: VT3 = MAXWELL.VEC[11]; \
 PORT real out VOLTAGE: EIT3 = MAXWELL.VEC[12]; \
 PORT real out MAGNETIC_FLUX: FLUXT3 = MAXWELL.VEC[13]; \
 PORT real out: TORQUE = MAXWELL.VEC[14]; \
 PORT real out: PHI = MAXWELL.VEC[15]; \
 PORT real out: OMEGA = MAXWELL.VEC[16]; \
 PORT real out: FEA_STEPS = MAXWELL.VEC[17]; \
 UMODEL FEA_LINK MAXWELL N0:=T1,N1:=T5,N2:=T2,N3:=T6,N4:=T3,N5:=T7,N6:=T4,N7:=T8 (host:= Maxwell_Host, port:= Maxwell_HostPort, min_fea_step:=hmin, VECSIZE:=18) SRC: DB(Lib:="Simplorer Elements\\Basic Elements\\Basic Elements"); \
