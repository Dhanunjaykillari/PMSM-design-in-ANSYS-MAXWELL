if y = "Forward_Euler" then
	PropHost.SetValue "INTEG_FORMULA", 0
else 
	if y = "Backward_Euler" then
		PropHost.SetValue "INTEG_FORMULA", 1
	else 
		if y = "Trapezoid" then
			PropHost.SetValue "INTEG_FORMULA", 2
		else 
			PropHost.SetValue "INTEG_FORMULA", 3
		end if
	end if
end if
