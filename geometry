\chapter{Geometry Modeling in Ansys Maxwell}

\section{Creating the Geometry}

\subsection{Main Geometrical Design}

The initial main dimensions of the PMSM are determined using the
fundamental output equation based on the magnetic and electric loadings.

The rated output power and mechanical speed are

\begin{equation}
P_{\mathrm{out}} = 5~\mathrm{kW}
\end{equation}

\begin{equation}
N = 2000~\mathrm{rpm}
\end{equation}

The corresponding mechanical speed in revolutions per second is

\begin{equation}
n = \frac{N}{60}
  = \frac{2000}{60}
  = 33.333~\mathrm{rps}.
\end{equation}

For a four-pole machine, the number of pole pairs is

\begin{equation}
p = \frac{P}{2}
  = \frac{4}{2}
  = 2.
\end{equation}

The distinction between the number of poles $P$ and pole pairs $p$ is
therefore

\begin{equation}
P = 2p.
\end{equation}

The electrical frequency is consequently

\begin{equation}
f_e = \frac{pN}{60}
    = \frac{2(2000)}{60}
    = 66.67~\mathrm{Hz}.
\end{equation}

\subsubsection{Selection of Magnetic and Electric Loading}

For a salient-pole synchronous/PMSM machine, the recommended average
air-gap magnetic loading is approximately

\begin{equation}
0.85 \leq B_{\mathrm{av}} \leq 1.05~\mathrm{T}.
\end{equation}

A mid-range value is selected as

\begin{equation}
\boxed{B_{\mathrm{av}} = 0.95~\mathrm{T}}.
\end{equation}

The specific electric loading is selected within the recommended range

\begin{equation}
35 \leq A \leq 65~\mathrm{kA/m}.
\end{equation}

Therefore, the selected value is

\begin{equation}
\boxed{A = 50~\mathrm{kA/m}}.
\end{equation}

\subsubsection{Winding Factor}

For the 24-slot, 3-phase, 4-pole winding,

\begin{equation}
q = \frac{Q_s}{2pm}
  = \frac{24}{2(2)(3)}
  = 2.
\end{equation}

The electrical angle between adjacent stator slots is

\begin{equation}
\alpha_s =
\frac{180p}{Q_s}
=
\frac{180(2)}{24}
=
15^\circ.
\end{equation}

For a coil pitch of five slots, the winding is short-pitched by one
slot. The pitch factor is therefore

\begin{equation}
k_p =
\cos\left(\frac{\alpha_s}{2}\right)
=
\cos(7.5^\circ)
=
0.9914.
\end{equation}

The distribution factor is

\begin{equation}
k_d =
\frac{\sin(q\alpha_s/2)}
{q\sin(\alpha_s/2)}
\end{equation}

\begin{equation}
k_d =
\frac{\sin(2\times15^\circ/2)}
{2\sin(15^\circ/2)}
=
0.9914.
\end{equation}

Hence, the winding factor is

\begin{equation}
k_w = k_p k_d
\end{equation}

\begin{equation}
k_w = (0.9914)(0.9914)
     \approx
     \boxed{0.983}.
\end{equation}

\subsubsection{Motor Output Equation}

The preliminary main dimensions are obtained from the motor output
equation

\begin{equation}
P_{\mathrm{out}} = G D^2 L n,
\end{equation}

where $D$ is the air-gap diameter, $L$ is the active stack length,
$n$ is the mechanical speed in revolutions per second, and $G$ is the
output coefficient.

The output coefficient is given by

\begin{equation}
G =
1.11\pi^2 k_w B_{\mathrm{av}} A.
\end{equation}

Using

\[
k_w=0.983,\qquad
B_{\mathrm{av}}=0.95~\mathrm{T},\qquad
A=50\times10^3~\mathrm{A/m},
\]

the output coefficient becomes

\begin{equation}
G =
1.11\pi^2(0.983)(0.95)(50\times10^3)
\end{equation}

\begin{equation}
\boxed{
G = 5.115\times10^5~
\mathrm{W/(m^3\,rps)}
}
\end{equation}

or

\begin{equation}
\boxed{
G = 511.5~
\mathrm{kW/(m^3\,rps)}.
}
\end{equation}

Therefore,

\begin{equation}
D^2L =
\frac{P_{\mathrm{out}}}{Gn}
\end{equation}

\begin{equation}
D^2L =
\frac{5000}
{(5.115\times10^5)(33.333)}
\end{equation}

\begin{equation}
\boxed{
D^2L = 2.9325\times10^{-4}~\mathrm{m^3}.
}
\end{equation}

\subsubsection{Pole Pitch and Aspect Ratio}

The pole pitch is

\begin{equation}
\tau_p = \frac{\pi D}{p}.
\end{equation}

The aspect ratio is defined as

\begin{equation}
a_r = \frac{L}{\tau_p}.
\end{equation}

For the initial analytical design, an aspect ratio of

\begin{equation}
\boxed{a_r=1.0}
\end{equation}

is selected. Hence,

\begin{equation}
L = \tau_p = \frac{\pi D}{p}.
\end{equation}

For $p=2$,

\begin{equation}
L = \frac{\pi D}{2}.
\end{equation}

Substituting into the $D^2L$ relation,

\begin{equation}
D^2\left(\frac{\pi D}{2}\right)
=
2.9325\times10^{-4}
\end{equation}

and therefore

\begin{equation}
D =
\left(
\frac{2(2.9325\times10^{-4})}{\pi}
\right)^{1/3}.
\end{equation}

Thus,

\begin{equation}
\boxed{D=57.15~\mathrm{mm}}.
\end{equation}

The corresponding active stack length is

\begin{equation}
L =
\frac{\pi(0.05715)}{2}
\end{equation}

\begin{equation}
\boxed{L=89.78~\mathrm{mm}}.
\end{equation}

The resulting pole pitch is

\begin{equation}
\boxed{\tau_p=89.78~\mathrm{mm}}.
\end{equation}
